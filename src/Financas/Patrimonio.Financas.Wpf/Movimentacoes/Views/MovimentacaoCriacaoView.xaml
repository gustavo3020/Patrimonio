<UserControl x:Class="Patrimonio.Financas.Wpf.Movimentacoes.Views.MovimentacaoCriacaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
             xmlns:vm="clr-namespace:Patrimonio.Financas.Wpf.Movimentacoes.ViewModels"
             mc:Ignorable="d"  
             d:DataContext="{d:DesignInstance vm:MovimentacaoCriacaoViewModel}">

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

        <!-- Data e tipo -->
        <Grid Grid.Row="0" Margin="0,0,0,16" ColumnDefinitions="*,*">

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Data" Margin="0,0,0,6"/>
                <DatePicker SelectedDate="{Binding Data}" Height="32"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Tipo" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Source={x:Static vm:MovimentacaoCriacaoViewModel.Tipos}}"
                          SelectedItem="{Binding Tipo}"
                          Height="32"/>
            </StackPanel>
        </Grid>

        <!-- Valor e natureza -->
        <Grid Grid.Row="1" Margin="0,0,0,16" ColumnDefinitions="*,*">

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Valor" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Valor}" Height="32"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Natureza" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Source={x:Static vm:MovimentacaoCriacaoViewModel.Naturezas}}"
                          SelectedItem="{Binding Natureza}" 
                          Height="32"/>
            </StackPanel>
        </Grid>

        <!-- Conta -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Conta" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding Contas}"
                      SelectedValue="{Binding ContaId}"
                      DisplayMemberPath="Nome"
                      SelectedValuePath="Id"
                      Height="32"/>
        </StackPanel>

        <!-- Categoria -->
        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <TextBlock Text="Categoria" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding Categorias}"
                      SelectedValue="{Binding CategoriaId}"
                      DisplayMemberPath="Nome"
                      SelectedValuePath="Id"
                      Height="32"/>
        </StackPanel>

        <!-- Descrição -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="Descrição" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Descricao}" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <!-- Espaço -->
        <Grid Grid.Row="5"/>

        <!-- Ações -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">

            <Button Content="Cancelar" Margin="0,0,8,0" Padding="16,8"/>
            <Button Content="Salvar" Command="{Binding SalvarCommand}" Padding="16,8"/>
        </StackPanel>
    </Grid>
</UserControl>