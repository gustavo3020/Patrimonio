<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Patrimonio.Financas.Wpf.Instituicoes.ViewModels"
                    xmlns:views="clr-namespace:Patrimonio.Financas.Wpf.Instituicoes.Views"
                    xmlns:nav="clr-namespace:Patrimonio.Financas.Wpf.Instituicoes.Navigation">

    <DataTemplate DataType="{x:Type vm:InstituicaoAlteracaoViewModel}">
        <views:InstituicaoAlteracaoView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:InstituicaoCriacaoViewModel}">
        <views:InstituicaoCriacaoView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:InstituicaoListaViewModel}">
        <views:InstituicaoListaView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type nav:InstituicaoNavigation}">
        <nav:InstituicaoNavigationView/>
    </DataTemplate>

</ResourceDictionary>