<Window x:Class="Patrimonio.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
        xmlns:nav="clr-namespace:Patrimonio.Wpf.Navigation"
        mc:Ignorable="d"
        Title="{Binding Titulo}"
        d:DataContext="{d:DesignInstance nav:AppNavigation}"
        MinWidth="1200"
        MinHeight="700">

    <Grid RowDefinitions="64,*">

        <!-- Barra superior -->
        <Border Grid.Row="0" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="24,0">
            <TextBlock Text="Patrimônio" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Border>

        <!-- Área principal -->
        <Grid Grid.Row="1" ColumnDefinitions="130, *">

            <!-- Barra lateral -->
            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
                <StackPanel Margin="12">
                    <Button Content="Finanças"
                            Style="{StaticResource MenuButtonStyle}"
                            Command="{Binding AbrirFinancasCommand}"/>
                </StackPanel>
            </Border>

            <!-- Conteúdo -->
            <ContentControl Grid.Column="1" Content="{Binding ConteudoAtual}"/>
        </Grid>
    </Grid>
</Window>
