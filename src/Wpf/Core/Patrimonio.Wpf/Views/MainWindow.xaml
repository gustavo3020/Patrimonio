<Window x:Class="Patrimonio.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
        xmlns:nav="clr-namespace:Patrimonio.Wpf.Navigation"
        mc:Ignorable="d"
        Title="{Binding Titulo}"
        d:DataContext="{d:DesignInstance nav:AppNavigation}"
        MinWidth="1200"
        MinHeight="700"
        Style="{StaticResource BaseWindowStyle}">

    <Grid RowDefinitions="48, *">

        <!-- Barra superior -->
        <Border Grid.Row="0" Style="{StaticResource BottomBorderStyle}">
            <TextBlock Text="{Binding Titulo}" Style="{StaticResource TitleTextBlockStyle}"/>
        </Border>

        <!-- Área principal -->
        <Grid Grid.Row="1" ColumnDefinitions="120, *">

            <!-- Barra lateral -->
            <Border Grid.Column="0" Style="{StaticResource RightBorderStyle}">
                <StackPanel>
                    <Button Content="Finanças"
                            Style="{StaticResource MenuButtonStyle}"
                            Command="{Binding AbrirFinancasCommand}"/>
                </StackPanel>
            </Border>

            <!-- Conteúdo -->
            <ContentControl Grid.Column="1" Content="{Binding ConteudoAtual}"/>
        </Grid>
    </Grid>
</Window>
