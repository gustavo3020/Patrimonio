<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Patrimonio.Financas.Wpf.Categorias.ViewModels"
                    xmlns:views="clr-namespace:Patrimonio.Financas.Wpf.Categorias.Views"
                    xmlns:nav="clr-namespace:Patrimonio.Financas.Wpf.Categorias.Navigation">

    <DataTemplate DataType="{x:Type vm:CategoriaAlteracaoViewModel}">
        <views:CategoriaAlteracaoView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CategoriaCriacaoViewModel}">
        <views:CategoriaCriacaoView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CategoriaListaViewModel}">
        <views:CategoriaListaView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type nav:CategoriaNavigation}">
        <nav:CategoriaNavigationView/>
    </DataTemplate>

</ResourceDictionary>